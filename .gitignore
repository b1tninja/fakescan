# --- Rust build output -------------------------------------------------------
# Any cargo target directory, including ones with a mangled name (an unquoted
# Windows path in CARGO_TARGET_DIR once created "tempfakescan-target-claude").
target/
/target*/
/*target*/
**/*.rs.bk
*.pdb

# --- Secrets and local configuration -----------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12

# --- Local state written by the daemon, tray and harness ---------------------
# The device registry lives in %LOCALAPPDATA%\fakescan; never commit a copy.
devices.json
devices.json.*
*.lock.json
fakescan-last-create-body.xml

# --- Generated by harness and lab runs ---------------------------------------
/data/
data/fakescan-lab/
# Personal scans must never be committed (real-device corpus lives outside the repo).
/scans/
/fixtures/scans/
*.log
*.trace
*.jsonl.trace

# --- Local scratch / one-off dumps -------------------------------------------
/check.err
/check.out
/selftest_body.py
/ollama_Modelfile*
/Gemini_Generated_Image_*.jpg
/HANDOFF.md
/tmp/
/scratch/
*.tmp
*.orig
*.rej
*.bak
*.swp
*~

# --- Editor, tool and OS cruft -------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
.cursor/
.claude/

# --- Microsoft WSD packages and extracted official schemas -------------------
# License forbids redistributing them. Fetch with scripts/Get-WsdSpecs.ps1.
# Our markdown notes under docs/reference/**/*.md stay tracked.
/docs/reference/upstream/
*.zip
*.ZIP
/docs/reference/**/*.xsd
/docs/reference/**/*.XSD
/docs/reference/**/*.wsdl
/docs/reference/**/*.WSDL
/docs/reference/**/*.doc
/docs/reference/**/*.DOC
/docs/reference/**/*.docx
/docs/reference/**/*.DOCX
# Named MS download bundles if dropped outside upstream/
**/ScanService.zip
**/ScanDevice.zip
**/PrintDevice.zip
**/Printer.zip

# Markdown generated from Microsoft's XSD files by fakescan-refs (fakescan-python wsd_docs).
# It is derived from the official schemas, so it is regenerated locally and never committed.
/docs/reference/schema/*.md

# --- Python lab package ------------------------------------------------------
python/**/__pycache__/
python/**/*.egg-info/
python/.pytest_cache/
python/.venv/
python/dist/
python/build/
# Built native extension and its leftovers (maturin develop, renamed-aside copies)
python/**/*.pyd
python/**/*.pyd.*
python/**/*.so
python/**/*.whl
python/**/_native*.old*
